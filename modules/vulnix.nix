{
  config,
  lib,
  pkgs,
  ...
}:

# Periodic vulnix scan of the system closure against the NVD CVE feeds:
#
# - A timer runs `vulnix` as a dynamic user (store queries go through the
#   nix daemon, the NVD cache lives in /var/cache/vulnix).
# - The JSON report is kept in /var/lib/vulnix/report.json and every
#   vulnerable package becomes one journal line (format in vulnscan-lib.nix).
# - The whitelist is declared in Nix and written as vulnix TOML.

let
  cfg = config.security.vulnix;
  vlib = import ./vulnscan-lib.nix { inherit lib; };

  # vulnix scans all its roots at once: findings cannot be attributed to one.
  target = if cfg.scanSystem && !cfg.scanGcRoots && cfg.paths == [ ] then "system" else "nix-store";

  # vulnix-whitelist(5). Section names must be quoted; JSON strings and
  # string arrays are valid TOML.
  whitelistRule =
    name: r:
    lib.concatStrings (
      [ "[${builtins.toJSON name}]\n" ]
      ++ lib.optional (r.cve != [ ]) "cve = ${builtins.toJSON r.cve}\n"
      ++ lib.optional (r.until != null) "until = ${builtins.toJSON r.until}\n"
      ++ lib.optional (r.comment != "") "comment = ${builtins.toJSON r.comment}\n"
      ++ lib.optional (r.issueUrl != [ ]) "issue_url = ${builtins.toJSON r.issueUrl}\n"
    );

  whitelistFile = pkgs.writeText "vulnix-whitelist.toml" (
    "# generated by security.nix (security.vulnix.whitelist)\n"
    + lib.concatStringsSep "\n" (lib.mapAttrsToList whitelistRule cfg.whitelist)
  );

  args = lib.escapeShellArgs (
    [
      "--json"
      "--show-whitelisted"
      "--cache-dir"
      "/var/cache/vulnix"
    ]
    ++ lib.optional cfg.runtimeOnly "--closure"
    ++ lib.optional cfg.scanSystem "--system"
    ++ lib.optional cfg.scanGcRoots "--gc-roots"
    ++ lib.optionals (cfg.mirror != null) [
      "--mirror"
      cfg.mirror
    ]
    ++ lib.concatMap (w: [
      "-w"
      w
    ]) ([ "${whitelistFile}" ] ++ cfg.whitelistFiles)
    ++ cfg.paths
  );

  # One line per vulnerable package; CVEs sorted by score for `top`.
  linesJq = pkgs.writeText "vulnix-lines.jq" ''
    ${vlib.jqLib}
    def hdr: "scanner=\"vulnix\"" + kv("target"; ${builtins.toJSON target});
    (.[]
      | select(.affected_by | length > 0)
      | . as $p
      | [ .affected_by[] | { id: ., score: ($p.cvssv3_basescore[.] // 0) } ]
      | sort_by(-.score, .id) as $v
      | "vulnerable " + hdr + kv("pname"; $p.pname) + kv("version"; $p.version)
        + kv("severity"; $v[0].score | sev_of_cvss) + kv("count"; $v | length)
        + kv("max_cvss"; $v[0].score) + kv("top"; [ $v[:3][].id ] | join(","))
        + kv("cves"; $p.affected_by | join(","))),
    ("scan_done " + hdr
      + kv("vulnerable"; map(select(.affected_by | length > 0)) | length)
      + kv("cves"; map(.affected_by | length) | add // 0)
      + kv("whitelisted"; map(.whitelisted | length) | add // 0))
  '';

  scan = pkgs.writeShellScript "vulnix-scan" ''
    set -u
    export PATH=${
      lib.makeBinPath [
        cfg.package
        pkgs.coreutils
        pkgs.jq
        config.nix.package
      ]
    }
    # `nix` keeps its own cache under $HOME.
    export HOME=/var/cache/vulnix NIX_REMOTE=daemon
    # vulnix calls `nix path-info` / `nix derivation show` and guesses from
    # `nix --help` whether to pass --experimental-features, wrongly with
    # current Nix: without flakes enabled on the host, every scan fails.
    export NIX_CONFIG="extra-experimental-features = nix-command"
    state=/var/lib/vulnix
    rc=0
    vulnix ${args} > "$state/report.json.tmp" || rc=$?
    # 0: nothing, 1: only whitelisted, 2: vulnerable (also any vulnix error,
    # which then prints no report).
    if [ "$rc" -gt 2 ] || ! jq -e 'type == "array"' "$state/report.json.tmp" > /dev/null 2>&1; then
      echo "scan_failed scanner=\"vulnix\" target=\"${target}\" rc=\"$rc\""
      exit 1
    fi
    mv "$state/report.json.tmp" "$state/report.json"
    jq -r -f ${linesJq} "$state/report.json"
  '';
in
{
  options.security.vulnix = {
    enable = lib.mkEnableOption ''
      periodic vulnix scans of the system closure against the NVD CVE
      feeds, one journal line per vulnerable package (MiniSOC alerts)'';

    package = lib.mkPackageOption pkgs "vulnix" { };

    scanSystem = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Scan the current system (`--system`).";
    };

    scanGcRoots = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Also scan every live GC root (old generations, `result` links): noisy.";
    };

    paths = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = [ "/home/alice/.nix-profile" ];
      description = "Extra store paths or links to scan.";
    };

    runtimeOnly = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Scan the runtime closure (`--closure`) instead of the build-time
        derivation closure, whose compilers, test tools and fetchers are not
        on the system and would only add noise.
      '';
    };

    whitelist = lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.submodule {
          options = {
            cve = lib.mkOption {
              type = lib.types.listOf (lib.types.strMatching "CVE-[0-9]{4}-[0-9]+");
              default = [ ];
              description = "CVEs accepted for this package; empty: all of them.";
            };
            until = lib.mkOption {
              type = lib.types.nullOr (lib.types.strMatching "[0-9]{4}-[0-9]{2}-[0-9]{2}");
              default = null;
              example = "2027-01-01";
              description = "The entry stops applying at this date (YYYY-MM-DD).";
            };
            comment = lib.mkOption {
              type = lib.types.str;
              default = "";
            };
            issueUrl = lib.mkOption {
              type = lib.types.listOf lib.types.str;
              default = [ ];
            };
          };
        }
      );
      default = { };
      example = lib.literalExpression ''
        {
          "openssl-3.0.13" = { cve = [ "CVE-2024-0727" ]; until = "2027-01-01"; comment = "not reachable"; };
          libxml2.comment = "CPE mismatch";
          "*".cve = [ "CVE-2023-12345" ];
        }
      '';
      description = ''
        Accepted findings (vulnix-whitelist(5)). The name is `pname`,
        `pname-version`, or `*` (any package; `cve` then required).
      '';
    };

    whitelistFiles = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      description = "Extra whitelist files or URLs (TOML or YAML), e.g. a shared team whitelist.";
    };

    mirror = lib.mkOption {
      type = lib.types.nullOr (lib.types.strMatching ".*/");
      default = null;
      example = "https://nvd.example.org/feeds/json/cve/2.0/";
      description = "NVD feed mirror (vulnix default: nvd.nist.gov). Must end with `/`.";
    };
  }
  // vlib.timerOptions "daily";

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = lib.all (n: builtins.match "[a-zA-Z0-9_.*-]+" n != null) (lib.attrNames cfg.whitelist);
        message = "security.vulnix.whitelist: names must be pname, pname-version or *.";
      }
      {
        assertion = !(cfg.whitelist ? "*") || cfg.whitelist."*".cve != [ ];
        message = "security.vulnix.whitelist.\"*\" needs a `cve` list.";
      }
      {
        assertion = cfg.scanSystem || cfg.scanGcRoots || cfg.paths != [ ];
        message = "security.vulnix: nothing to scan (scanSystem, scanGcRoots or paths).";
      }
    ];

    systemd.services.vulnix = {
      description = "Scan the system closure for known vulnerabilities (vulnix)";
      wants = [ "network-online.target" ];
      after = [
        "network-online.target"
        "nix-daemon.socket"
      ];
      serviceConfig = vlib.hardening // {
        ExecStart = scan;
        StateDirectory = "vulnix";
        CacheDirectory = "vulnix";
        # The first run downloads several years of NVD feeds.
        TimeoutStartSec = "2h";
      };
    };

    systemd.timers.vulnix = vlib.mkTimer cfg;

    environment.systemPackages = [ cfg.package ];
  };
}
