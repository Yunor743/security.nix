NixOS manages /etc declaratively via symlinks to the Nix store.
fapolicyd uses O_NOFOLLOW when opening its config and rules files,
which breaks on NixOS where /etc/fapolicyd/* are symlinks.
Remove O_NOFOLLOW so the daemon can follow symlinks.

diff --git a/src/library/daemon-config.c b/src/library/daemon-config.c
index a853163..2b270bf 100644
--- a/src/library/daemon-config.c
+++ b/src/library/daemon-config.c
@@ -171,7 +171,7 @@ int load_daemon_config(conf_t *config)
 	clear_daemon_config(config);
 
 	/* open the file */
-	fd = open(CONFIG_FILE, O_RDONLY|O_NOFOLLOW);
+	fd = open(CONFIG_FILE, O_RDONLY);
 	if (fd < 0) {
 		if (errno != ENOENT) {
 			msg(LOG_ERR, "Error opening config file (%s)",
diff --git a/src/library/policy.c b/src/library/policy.c
